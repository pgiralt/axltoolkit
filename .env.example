# Template for the .env file used by samples and integration tests.
#
# Copy this file to ``.env`` (which is gitignored) and fill in the
# values that match your lab UCM. The samples and the
# ``tests/integration/`` suite both read these variables via
# python-dotenv (see ``samples/_env.py`` and
# ``tests/integration/conftest.py``).
#
# Never commit a real ``.env`` — only this template.

# ── Required ──────────────────────────────────────────────────────────

# UCM publisher hostname or IP
UCM_ADDRESS=ucm-pub.example.com

# AXL application-user credentials
UCM_USERNAME=axladmin
UCM_PASSWORD=replace-me

# ── Optional ──────────────────────────────────────────────────────────

# Platform / OS administrator credentials (required for PAWS and
# LogCollection). If left unset, the samples fall back to UCM_USERNAME /
# UCM_PASSWORD, which only works if your AXL user is also a platform
# admin.
UCM_PLATFORM_USERNAME=administrator
UCM_PLATFORM_PASSWORD=replace-me

# AXL schema version to use when building the SOAP client. Pick the
# version closest to your UCM release (10.0, 10.5, 11.0, 11.5, 12.0,
# 12.5, 14.0, or 15.0).
UCM_AXL_VERSION=15.0

# TLS verification (REQUIRED for production):
#   * ``true``  — verify against the system CA store (default, recommended)
#   * /path/to/ca.pem — verify against a specific CA bundle
#   * ``false`` — disable verification (LAB ONLY — exposes you to MITM
#                 attacks against your UCM cluster). Never use in
#                 production. Override locally only when your lab UCM
#                 uses a self-signed Tomcat cert.
UCM_TLS_VERIFY=true

# HTTP request timeout in seconds
UCM_TIMEOUT=30

# Timeout for LogCollection / DimeGetFile operations (large transfers)
UCM_LOG_TIMEOUT=120
